      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login as Student (Aarav)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('student_token', jsonData.access_token);",
                  "    pm.environment.set('student_token', jsonData.access_token);",
                  "    console.log('Saved student_token to variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_aarav\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as a Student (Aarav Patel) and automatically extracts the JWT token into {{student_token}}."
          }
        },
        {
          "name": "Login as Teacher (Dr. Priya)",
          "event": [
